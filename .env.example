# Supabase → Project Settings → Database → Connection string
# Pooled (Transaction mode, port 6543) for the app:
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (port 5432) for prisma db push / migrate:
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET="change-me"

# Identify your scraper honestly, with a contact page.
SCRAPER_USER_AGENT="PeekStockChecker/0.1 (+https://your-domain.example/bot)"
