# On Vercel these two are added automatically by the Neon integration
# (Storage → Neon). For local development, copy them from Vercel:
#   Project → Settings → Environment Variables, or `vercel env pull`.
DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://.../neondb?sslmode=require"

# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Set the same value as a GitHub Actions secret for the 30-minute scraper.
CRON_SECRET="change-me"

# Optional. Identify your scraper honestly, with a contact page.
SCRAPER_USER_AGENT="PeekStockChecker/0.1 (+https://your-domain.example/bot)"
