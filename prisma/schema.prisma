// Peek — Prisma schema (PostgreSQL via Vercel's Neon integration)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // pooled connection — set automatically by Vercel's Neon integration
  directUrl = env("DATABASE_URL_UNPOOLED") // direct connection, used by `prisma db push` during the build
}

enum Retailer {
  POKEMON_CENTER
  SMYTHS
  GAME
  MAGIC_MADHOUSE
  CHAOS_CARDS
}

// Declaration order matters: Postgres sorts enums by it, so ORDER BY status
// puts in-stock items first on the dashboard.
enum StockStatus {
  IN_STOCK
  QUEUE        // retailer waiting room is up — usually means a drop is live
  PREORDER
  COMING_SOON
  OUT_OF_STOCK
  UNKNOWN
}

enum ProductType {
  ETB
  BOOSTER_BOX
  BOOSTER_BUNDLE
  BOOSTER_PACK
  BLISTER
  PREMIUM_COLLECTION
  COLLECTION_BOX
  TIN
  OTHER
}

enum Language {
  EN
  JP
  OTHER // Korean, European languages, Thai…
  ZH    // Chinese (simplified or traditional)
}

enum ListingSource {
  SEED    // found by the daily discovery crawl of the built-in stores
  USER    // pasted in by a user
  CATALOG // found by scanning a whole shop's catalogue (see Shop)
}

/// A canonical product ("Perfect Order Elite Trainer Box"), shared by every
/// retailer that sells it. Grouping key is `slug`, built by lib/products.ts.
model Product {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  expansion String?      // key from lib/categorize.ts, e.g. "perfect-order"
  type      ProductType  @default(OTHER)
  language  Language     @default(EN)
  hot       Boolean      @default(false) // sought-after set: polled more often
  rrpPence  Int?         // RRP set by the user; applies to this product at every shop
  listings  TrackedUrl[]
  createdAt DateTime     @default(now())

  @@index([expansion, type])
}

/// One product page at any shop — the thing the scraper polls.
model TrackedUrl {
  id            String        @id @default(cuid())
  url           String        @unique // normalised: https, no tracking params
  host          String?       // shop's domain without "www." — for fast per-shop filters and counts
  retailer      Retailer?     // set for the built-in stores; null for any other shop
  source        ListingSource @default(USER)
  active        Boolean       @default(true)

  productId     String?
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  title         String?
  imageUrl      String?

  // Current state (last *successful* check — a failed fetch never overwrites it)
  status        StockStatus   @default(UNKNOWN)
  pricePence    Int?
  wasPricePence Int?
  onSale        Boolean       @default(false)
  rrpPence      Int?          // RRP printed on the shop's own page, if any
  priceSource   String?       // where the price was read: "shop catalogue", "product data", "page meta", "page markup"

  // Scheduling
  priority      Int           @default(0) // >0 = hot item, shorter poll interval
  nextCheckAt   DateTime      @default(now())
  lastCheckedAt DateTime?
  lastChangedAt DateTime?
  lastInStockAt DateTime?
  failCount     Int           @default(0) // consecutive failed fetches (timeouts, blocks)
  lastError     String?

  checks        StockCheck[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([active, nextCheckAt])
  @@index([host, active])
  @@index([status])
  @@index([onSale])
}

/// Stock history. Written only when status/price changes or a check fails,
/// so the free-tier database doesn't fill up with identical rows.
model StockCheck {
  id           String      @id @default(cuid())
  trackedUrlId String
  trackedUrl   TrackedUrl  @relation(fields: [trackedUrlId], references: [id], onDelete: Cascade)
  status       StockStatus
  pricePence   Int?
  httpStatus   Int?
  durationMs   Int?
  error        String?
  checkedAt    DateTime    @default(now())

  @@index([trackedUrlId, checkedAt])
}

/// Upcoming releases and retailer allocation / raffle sign-ups (curated by hand).
model Drop {
  id            String       @id @default(cuid())
  title         String
  expansion     String?
  type          ProductType?
  retailer      Retailer?
  releaseDate   DateTime?
  allocationUrl String?      // sign-up / raffle / ballot link
  notes         String?
  createdAt     DateTime     @default(now())

  @@index([releaseDate])
}

/// A website whose whole catalogue is scanned for Pokémon TCG products.
/// Shopify shops: /products.json (stock included). Others: product URLs from
/// sitemap.xml, each then checked like a pasted link.
model Shop {
  id            String    @id @default(cuid())
  host          String    @unique
  name          String
  platform      String    @default("shopify") // "shopify" (catalogue JSON), "sitemap" (product URLs from sitemap.xml) or "listing" (product links on a category page)
  collection    String?   // Shopify: scan only /collections/<this>. Listing: the category page URL. Null = whole shop.
  enabled       Boolean   @default(true)
  status        String    @default("active") // "checking" (new, not verified yet) | "active" | "not-uk" | "unreadable"
  origin        String    @default("you")    // "you" | "starter list" | "found on web"
  scanPage      Int       @default(1) // resume point: big catalogues span several runs
  nextScanAt    DateTime  @default(now())
  lastScannedAt DateTime?
  productsFound Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())
}

/// Release news, deals and restock posts found in web feeds ("online"), and
/// in-store releases/events such as pre-release events found in shop
/// catalogues ("in-store").
model DropItem {
  id          String    @id @default(cuid())
  url         String    @unique
  title       String
  kind        String    @default("online") // "online" | "in-store"
  source      String    // feed or shop name, e.g. "HotUKDeals"
  summary     String?
  imageUrl    String?
  releaseDate DateTime? // parsed from the text when a date is mentioned
  publishedAt DateTime
  hidden      Boolean   @default(false) // deleted by the user; kept so feeds don't add it back
  // Read from the page for links you add (product pages):
  status      String?   // "Product drop" | "Raffle" | "Pre-order" | "Coming soon" | "In stock" | "Sold out"
  pricePence  Int?
  entryUrl    String?   // where to enter the drop/raffle, if the page links to it
  purchaseLimit Int?    // "limited to 1 per customer"
  checkedAt   DateTime? // last time the page was re-read
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
  @@index([releaseDate])
  @@index([kind])
}

/// Throttle for jobs that run less often than the 5-minute scheduler.
model JobRun {
  name      String   @id
  lastRunAt DateTime
  info      String?  // JSON summary of the last run, shown on the pages (e.g. which feeds worked)
}

/// RRP table (Settings page). The first enabled row whose keywords match a
/// product title gives that product's RRP when no better source is found.
model RrpRule {
  id        String   @id @default(cuid())
  name      String   // e.g. "Elite Trainer Box"
  keywords  String   // comma-separated phrases; a phrase matches if all its words are in the title
  rrpPence  Int      // RRP used for the price comparison
  lowPence  Int?     // optional low end of the usual range, for reference
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Web sources for Product drops and In store (Settings page).
model FeedSource {
  id        String   @id @default(cuid())
  name      String
  url       String   @unique
  kind      String   @default("news")  // "news" (only release/stock posts) or "deal" (every TCG post)
  page      String   @default("auto")  // "online" | "in-store" | "auto"
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

/// General settings (Settings page), stored as key → JSON value.
model Setting {
  key   String @id
  value String
}
